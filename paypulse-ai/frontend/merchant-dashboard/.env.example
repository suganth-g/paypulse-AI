# PayPulse AI — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Backend API base URL (Java Spring Boot service)
# Will be set when Phase 2 backend is implemented.
VITE_API_BASE_URL=http://localhost:8080

# AI Service base URL (Python FastAPI service)
# Will be set when Phase 3 AI service is implemented.
VITE_AI_SERVICE_URL=http://localhost:8000

# App name (displayed in UI)
VITE_APP_NAME=PayPulse AI

# Set to 'true' to show demo data banners
VITE_DEMO_MODE=true

